{
  "name": "UnderCover",
  "image": "mcr.microsoft.com/devcontainers/python:3-3.12-trixie",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "26"
    }
  },
  "workspaceMount": "source=${localWorkspaceFolder}/../..,target=/workspaces/undercover,type=bind",
  "workspaceFolder": "/workspaces/undercover",
  "postCreateCommand": "git config --global --add safe.directory /workspaces/undercover && curl -LsSf https://astral.sh/uv/install.sh | sh && $HOME/.local/bin/uv sync && npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
